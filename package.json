{
  "name": "@gcu/capsule",
  "version": "0.1.0",
  "description": "Fragment-based content addressing for browser-native tools — a compact string that resolves to bytes, carried inline (URL fragment / QR) or referenced (GitHub, gist, Zenodo, …). Zero runtime dependencies.",
  "type": "module",
  "license": "MIT",
  "author": "Geoscientific Chaos Union",
  "homepage": "https://gentropic.org/capsule",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gentropic/capsule.git"
  },
  "keywords": [
    "capsule",
    "content-addressing",
    "url-fragment",
    "qr",
    "base45",
    "deflate",
    "share-link",
    "gcu",
    "offline"
  ],
  "files": [
    "src",
    "dist",
    "index.d.ts",
    "vectors.json",
    "SPEC-capsule.md",
    "CAPSULES.md",
    "ROADMAP.md",
    "README.md",
    "LICENSE"
  ],
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./src/index.js"
    },
    "./bundled": {
      "types": "./index.d.ts",
      "default": "./dist/capsule.js"
    },
    "./codecs": "./src/codecs.js",
    "./share": "./src/share.js",
    "./dispatcher": "./src/dispatcher.js",
    "./loaders/inline": "./src/loaders/inline.js",
    "./loaders/url": "./src/loaders/url.js",
    "./loaders/gh": "./src/loaders/gh.js",
    "./loaders/gist": "./src/loaders/gist.js",
    "./loaders/zenodo": "./src/loaders/zenodo.js",
    "./loaders/doi": "./src/loaders/doi.js",
    "./loaders/rentry": "./src/loaders/rentry.js"
  },
  "sideEffects": false,
  "scripts": {
    "test": "node --test",
    "build": "node build/bundle.js",
    "build:check": "node build/bundle.js --check",
    "vectors": "node scripts/gen-vectors.js"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "peerDependencies": {
    "pako": "^2"
  },
  "peerDependenciesMeta": {
    "pako": {
      "optional": true
    }
  }
}
